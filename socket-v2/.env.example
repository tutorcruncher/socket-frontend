# Copy to `.env` for local development.

# API the widget talks to by default (overridable per-instance via config.api_root)
VITE_SOCKET_API_URL=https://socket.tutorcruncher.com

# Google reCAPTCHA v2 site key (enquiry form)
VITE_GRECAPTCHA_KEY=6LdyXRgUAAAAADUNhMVKJDXiRr6DUN8TGOgllqbt

# Optional Sentry DSN: only reports errors originating from the widget bundle
VITE_SENTRY_DSN=

# Build release identifier (set by CI)
VITE_RELEASE=dev

# Demo page only (npm run dev)
VITE_DEMO_PUBLIC_KEY=9c79f14df986a1ec693c
VITE_DEMO_API_ROOT=

# Mock the V2 appointments contract (delivery modes + geocoded addresses) that
# the backend has not built yet. Set to false once the real API serves them.
VITE_USE_MOCK_API=true
